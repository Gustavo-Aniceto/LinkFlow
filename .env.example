# Copie para ".env" e ajuste. Todas as variáveis são opcionais.

# --- IA (deixe em branco para usar o MODO DEMONSTRATIVO, resultados SIMULADOS) ---
# Se as duas estiverem preenchidas, a Anthropic tem prioridade.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Provedores gratuitos compatíveis (Groq, Gemini, OpenRouter): defina a URL base e o modelo
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT=90

# --- Aplicação ---
# Se vazio, uma chave aleatória é criada em data/.secret_key
SECRET_KEY=
HOST=127.0.0.1
PORT=5000
# Pasta do banco SQLite e dos PDFs enviados (padrão: ./data)
# LINKFLOW_DATA_DIR=./data

# --- Produção (Vercel) ---
# DATABASE_URL: string de conexão Postgres (a integração Neon da Vercel preenche sozinha). Vazio = SQLite local.
# ALLOWED_EMAILS: lista (separada por vírgula) dos e-mails que podem criar conta. Vazio = qualquer pessoa.
# MAX_SENDS_PER_DAY: limite de candidaturas enviadas por e-mail em 24h (padrão 10).
DATABASE_URL=
ALLOWED_EMAILS=
MAX_SENDS_PER_DAY=10
